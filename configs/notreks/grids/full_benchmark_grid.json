{
  "experiment_id": "notreks_full_benchmark",
  "benchmark_name": "notreks_full_benchmark_validation",
  "filename_prefix": "notreks/full_benchmark/validation/",
  "data": {
    "type": "fixed",
    "seeds": [101, 102, 103, 104, 105, 106, 107, 108, 109, 110],
    "d": 10,
    "n": 500,
    "graph": "er",
    "expected_degree": 2,
    "standardized": true
  },
  "methods": {
    "gcastle_pc": {
      "enabled": true,
      "grid": {
        "variant": ["stable"],
        "alpha": [0.01, 0.05, 0.1],
        "ci_test": ["fisherz"],
        "timeout": [null]
      }
    },
    "gcastle_direct_lingam": {
      "enabled": true,
      "grid": {
        "measure": ["pwling", "kernel"],
        "thresh": [0.3],
        "timeout": [null]
      }
    },
    "notreks": {
      "enabled": true,
      "grid": {
        "score": ["least_squares"],
        "dag_seq": ["exp", "logdet", "scc_power_iteration"],
        "trek_seq": ["exp"],
        "trek_reg": [0.1, 1.0],
        "regularizer": ["l1"],
        "regularizer_scale": [0.001, 0.01],
        "independence_test": ["spearman", "dcor", "gcastle_fisherz"],
        "independence_alpha": [0.05],
        "independence_correction": ["benjamini-hochberg"],
        "threshold": [0.1],
        "max_iter": [30000],
        "path_steps": [5],
        "power_iter_steps": [5],
        "timeout": [null]
      }
    }
  },
  "selection": {
    "primary_metric": "SHD_cpdag",
    "mode": "minimize",
    "group_by": "method_family"
  }
}

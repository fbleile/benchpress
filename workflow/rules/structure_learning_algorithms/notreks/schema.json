{
  "title": "NOTREKS",
  "description": "Local Benchpress configuration for the NOTREKS structure-learning module.",
  "type": "array",
  "items": {
    "title": "NOTREKS configuration",
    "description": "Configuration for one local NOTREKS run.",
    "type": "object",
    "properties": {
      "id": {
        "description": "Algorithm identifier",
        "type": "string"
      },
      "alg_id": {
        "description": "Short path-forming algorithm identifier used by generated hyperparameter configs.",
        "type": "string"
      },
      "params_manifest": {
        "description": "Optional manifest JSON path for resolving full hyperparameters from alg_id.",
        "type": "string"
      },
      "function_class": {
        "description": "Function class. Only linear is implemented in this local module.",
        "type": "string",
        "enum": ["linear"]
      },
      "score": {
        "description": "Score used by the linear estimator. The optimizer currently supports least_squares.",
        "type": "string",
        "enum": ["least_squares", "gaussian_likelihood"]
      },
      "dag_seq": {
        "description": "DAG penalty sequence.",
        "type": "string",
        "enum": ["None", "none", "exp", "log", "inv", "logdet", "scc_power_iteration"]
      },
      "dag_reg": {
        "description": "Non-negative scaling factor for the DAG penalty.",
        "$ref": "#/$defs/nonnegnum"
      },
      "dag_s": {
        "description": "Positive log-det barrier parameter.",
        "type": "number",
        "exclusiveMinimum": 0
      },
      "trek_seq": {
        "description": "Trek penalty sequence.",
        "type": "string",
        "enum": ["none", "exp", "log", "inv"]
      },
      "trek_reg": {
        "description": "Non-negative scaling factor for the trek penalty.",
        "$ref": "#/$defs/nonnegnum"
      },
      "regularizer": {
        "description": "Coefficient regularizer.",
        "type": "string",
        "enum": ["none", "l1", "l2"]
      },
      "regularizer_scale": {
        "description": "Non-negative regularizer scaling factor.",
        "$ref": "#/$defs/nonnegnum"
      },
      "independence_test": {
        "description": "Pairwise marginal-independence proxy.",
        "type": "string",
        "enum": ["none", "pearson", "spearman", "hsic", "dcor", "gcastle_fisherz", "gcastle_g2", "gcastle_chi2"]
      },
      "independence_alpha": {
        "description": "Significance level for pairwise tests.",
        "type": "number",
        "exclusiveMinimum": 0,
        "exclusiveMaximum": 1
      },
      "independence_correction": {
        "description": "Multiple-testing correction.",
        "type": "string",
        "enum": ["none", "bonferroni", "benjamini-hochberg"]
      },
      "seed": {
        "description": "Random seed.",
        "type": "integer"
      },
      "max_iter": {
        "description": "Positive optimizer iteration limit used for every central-path stage by the current max_every_stage policy.",
        "type": "integer",
        "minimum": 1
      },
      "lr": {
        "description": "Positive Adam learning rate for each optimizer stage.",
        "type": "number",
        "exclusiveMinimum": 0
      },
      "path_steps": {
        "description": "Positive number of DAGMA-style central-path stages.",
        "type": "integer",
        "minimum": 1
      },
      "mu_init": {
        "description": "Positive initial central-path multiplier for the score and ordinary regularizer.",
        "type": "number",
        "exclusiveMinimum": 0
      },
      "mu_factor": {
        "description": "Central-path multiplier decay factor in (0, 1).",
        "type": "number",
        "exclusiveMinimum": 0,
        "exclusiveMaximum": 1
      },
      "warm_iter": {
        "description": "Compatibility field retained for existing configs. The current optimizer uses max_iter for every stage and does not consume warm_iter.",
        "type": "integer",
        "minimum": 1
      },
      "tol": {
        "description": "Positive numerical stopping tolerance.",
        "type": "number",
        "exclusiveMinimum": 0
      },
      "threshold": {
        "description": "Non-negative threshold for binarizing the weighted adjacency matrix.",
        "$ref": "#/$defs/nonnegnum"
      },
      "timeout": {
        "description": "Timeout in seconds, or null.",
        "$ref": "#/$defs/flexnonnegnumnull"
      },
      "init": {
        "description": "Optimizer initialization. Use zero for DAGMA-equivalence experiments; linear_baseline is an ablation.",
        "type": "string",
        "enum": ["zero", "linear_baseline"]
      },
      "checkpoint": {
        "description": "Optimizer diagnostic checkpoint interval in inner iterations.",
        "type": "integer",
        "minimum": 1
      },
      "power_iter_steps": {
        "description": "Power-iteration steps for experimental SCC power-iteration DAG penalties.",
        "type": "integer",
        "minimum": 1
      },
      "scc_threshold": {
        "description": "Non-negative support threshold for SCC detection in scc_power_iteration.",
        "$ref": "#/$defs/nonnegnum"
      },
      "independence_cache_dir": {
        "description": "Optional directory for parameter-specific cached pairwise independence-test results.",
        "type": ["string", "null"]
      },
      "trek_penalty_mu_mode": {
        "description": "Controls whether the no-trek penalty is hard outside the central-path multiplier or soft inside it.",
        "type": "string",
        "enum": ["hard_outside_mu", "soft_inside_mu"],
        "default": "hard_outside_mu"
      }
    },
    "anyOf": [
      {
        "required": [
          "id",
          "function_class",
          "score",
          "dag_seq",
          "dag_reg",
          "dag_s",
          "trek_seq",
          "trek_reg",
          "regularizer",
          "regularizer_scale",
          "independence_test",
          "independence_alpha",
          "independence_correction",
          "seed",
          "max_iter",
          "lr",
          "path_steps",
          "mu_init",
          "mu_factor",
          "warm_iter",
          "tol",
          "threshold",
          "timeout"
        ]
      },
      {
        "required": [
          "id",
          "alg_id",
          "params_manifest"
        ]
      }
    ],
    "additionalProperties": false,
    "examples": [
      {
        "id": "notreks-local",
        "function_class": "linear",
        "score": "least_squares",
        "dag_seq": "none",
        "dag_reg": 0,
        "dag_s": 1,
        "trek_seq": "none",
        "trek_reg": 0,
        "regularizer": "none",
        "regularizer_scale": 0,
        "independence_test": "pearson",
        "independence_alpha": 0.05,
        "independence_correction": "benjamini-hochberg",
        "seed": 1,
        "max_iter": 300,
        "lr": 0.0003,
        "path_steps": 3,
        "mu_init": 1.0,
        "mu_factor": 0.1,
        "warm_iter": 100,
        "tol": 0.000001,
        "threshold": 0.1,
        "timeout": null,
        "init": "zero",
        "checkpoint": 100,
        "power_iter_steps": 5,
        "scc_threshold": 1e-8,
        "independence_cache_dir": null,
        "trek_penalty_mu_mode": "hard_outside_mu"
      }
    ]
  },
  "uniqueItems": true
}
